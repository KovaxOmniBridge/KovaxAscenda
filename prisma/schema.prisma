generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Empresa {
  id           Int      @id @default(autoincrement())
  nome         String
  usuarios     Usuario[]
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nome         String
  email        String   @unique
  empresaId    Int
  empresa      Empresa  @relation(fields: [empresaId], references: [id])
}