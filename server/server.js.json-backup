// =====================================================
// MIDDLEWARE DE AUTENTICAÇÃO
// =====================================================

/**
 * Middleware para verificar JWT
 */
function authenticateToken(req, res, next) {
  const authHeader = req.headers['authorization'];
  const token = authHeader && authHeader.split(' ')[1];

  if (!token) {
    return res.status(401).json({ message: 'Token não fornecido' });
  }

  jwt.verify(token, JWT_SECRET, (err, user) => {
    if (err) {
      return res.status(403).json({ message: 'Token inválido ou expirado' });
    }
    req.user = user;
    next();
  });
}

// =====================================================
// ROTAS DE AUTENTICAÇÃO
// =====================================================

/**
 * POST /api/auth/login
 * Login com email e senha
 */
app.post('/api/auth/login', async (req, res) => {
  try {
    const { email, password } = req.body;

    if (!email || !password) {
      return res.status(400).json({ message: 'Email e senha são obrigatórios' });
    }

    // Buscar usuário
    const users = await readData('users.json');
    const user = users.find(u => u.email === email);

    if (!user) {
      return res.status(401).json({ message: 'Credenciais inválidas' });
    }

    // Verificar senha
    const validPassword = await bcrypt.compare(password, user.password);
    if (!validPassword) {
      return res.status(401).json({ message: 'Credenciais inválidas' });
    }

    // Buscar organização
    const organizations = await readData('organizations.json');
    const organization = organizations.find(o => o.id === user.organizationId);

    // Gerar token JWT
    const token = jwt.sign(
      { 
        id: user.id, 
        email: user.email, 
        organizationId: user.organizationId 
      },
      JWT_SECRET,
      { expiresIn: JWT_EXPIRES_IN }
    );

    // Resposta
    res.json({
      user: {
        id: user.id,
        name: user.name,
        email: user.email,
        role: user.role,
        organization: organization ? organization.name : 'N/A',
        permissions: {
          toolCategories: user.permissions.toolCategories || [],
          can_access_dev: user.permissions.canAccessDev || false
        }
      },
      token
    });

  } catch (error) {
    console.error('Erro no login:', error);
    res.status(500).json({ message: 'Erro interno do servidor' });
  }
});

/**
 * POST /api/auth/login/client
 * Login de CLIENTES (usuários de empresas)
 */
app.post('/api/auth/login/client', async (req, res) => {
  try {
    const { email, password } = req.body;

    if (!email || !password) {
      return res.status(400).json({ message: 'Email e senha são obrigatórios' });
    }

    // Buscar usuário
    const users = await readData('users.json');
    const user = users.find(u => u.email === email);

    if (!user) {
      return res.status(401).json({ message: 'Credenciais inválidas' });
    }

    // Verificar senha
    const validPassword = await bcrypt.compare(password, user.password);
    if (!validPassword) {
      return res.status(401).json({ message: 'Credenciais inválidas' });
    }

    // Buscar organização
    const organizations = await readData('organizations.json');
    const organization = organizations.find(o => o.id === user.organizationId);

    // Gerar token JWT
    const token = jwt.sign(
      { 
        id: user.id, 
        email: user.email, 
        organizationId: user.organizationId,
        type: 'client'
      },
      JWT_SECRET,
      { expiresIn: '24h' }
    );

    // Resposta
    res.json({
      user: {
        id: user.id,
        name: user.name,
        email: user.email,
        role: user.role,
        organization: organization ? organization.name : 'N/A',
        permissions: {
          toolCategories: user.permissions.toolCategories || []
        }
      },
      token
    });

  } catch (error) {
    console.error('Erro no login de cliente:', error);
    res.status(500).json({ message: 'Erro interno do servidor' });
  }
});

/**
 * POST /api/auth/login/developer
 * Login de DESENVOLVEDORES (acesso total à plataforma)
 */
app.post('/api/auth/login/developer', async (req, res) => {
  try {
    const { email, password } = req.body;

    if (!email || !password) {
      return res.status(400).json({ message: 'Email e senha são obrigatórios' });
    }

    // Buscar desenvolvedor
    const developers = await readData('developers.json');
    const developer = developers.find(d => d.email === email);

    if (!developer) {
      return res.status(401).json({ message: 'Acesso negado - Credenciais inválidas' });
    }

    // Verificar senha
    const validPassword = await bcrypt.compare(password, developer.password);
    if (!validPassword) {
      return res.status(401).json({ message: 'Acesso negado - Credenciais inválidas' });
    }

    // Atualizar último login
    developer.lastLogin = new Date().toISOString();
    await writeData('developers.json', developers);

    // Gerar token JWT com tempo menor (2h para segurança)
    const token = jwt.sign(
      { 
        id: developer.id, 
        email: developer.email,
        type: 'developer',
        permissions: developer.permissions
      },
      JWT_SECRET,
      { expiresIn: '2h' }
    );

    // Log de segurança
    console.log(`🔐 DEV LOGIN: ${developer.name} (${developer.email}) em ${new Date().toLocaleString('pt-BR')}`);

    // Resposta
    res.json({
      user: {
        id: developer.id,
        name: developer.name,
        email: developer.email,
        role: developer.role,
        permissions: developer.permissions
      },
      token
    });

  } catch (error) {
    console.error('Erro no login de desenvolvedor:', error);
    res.status(500).json({ message: 'Erro interno do servidor' });
  }
});

/**
 * POST /api/auth/logout
 * Logout (cliente deve descartar o token)
 */
app.post('/api/auth/logout', (req, res) => {
  res.json({ message: 'Logout realizado com sucesso' });
});

/**
 * GET /api/auth/verify
 * Verificar token e retornar dados do usuário
 */
app.get('/api/auth/verify', authenticateToken, async (req, res) => {
  try {
    const users = await readData('users.json');
    const user = users.find(u => u.id === req.user.id);

    if (!user) {
      return res.status(404).json({ message: 'Usuário não encontrado' });
    }

    const organizations = await readData('organizations.json');
    const organization = organizations.find(o => o.id === user.organizationId);

    res.json({
      user: {
        id: user.id,
        name: user.name,
        email: user.email,
        role: user.role,
        organization: organization ? organization.name : 'N/A',
        permissions: {
          toolCategories: user.permissions.toolCategories || [],
          can_access_dev: user.permissions.canAccessDev || false
        }
      }
    });
  } catch (error) {
    console.error('Erro ao verificar token:', error);
    res.status(500).json({ message: 'Erro interno do servidor' });
  }
});

// =====================================================
// ROTAS DE ORGANIZAÇÕES
// =====================================================

/**
 * GET /api/organizations
 * Listar todas as organizações (apenas desenvolvedores)
 */
app.get('/api/organizations', authenticateToken, async (req, res) => {
  try {
    // Apenas desenvolvedores podem listar todas as organizações
    if (req.user.type !== 'developer') {
      return res.status(403).json({ message: 'Acesso negado' });
    }

    const organizations = await readData('organizations.json');
    const users = await readData('users.json');

    // Adicionar contagem de usuários para cada organização
    const organizationsWithCount = organizations.map(org => ({
      ...org,
      userCount: users.filter(u => u.organizationId === org.id).length
    }));

    res.json(organizationsWithCount);
  } catch (error) {
    console.error('Erro ao listar organizações:', error);
    res.status(500).json({ message: 'Erro interno do servidor' });
  }
});

// =====================================================
// ROTAS DE USUÁRIOS
// =====================================================

/**
 * GET /api/users
 * Listar usuários da organização
 */
app.get('/api/users', authenticateToken, async (req, res) => {
  try {
    const users = await readData('users.json');
    const orgUsers = users
      .filter(u => u.organizationId === req.user.organizationId)
      .map(u => ({
        id: u.id,
        name: u.name,
        email: u.email,
        role: u.role,
        createdAt: u.createdAt
      }));

    res.json(orgUsers);
  } catch (error) {
    console.error('Erro ao listar usuários:', error);
    res.status(500).json({ message: 'Erro interno do servidor' });
  }
});

/**
 * GET /api/users/:id
 * Detalhes de um usuário
 */
app.get('/api/users/:id', authenticateToken, async (req, res) => {
  try {
    const users = await readData('users.json');
    const user = users.find(u => 
      u.id === req.params.id && 
      u.organizationId === req.user.organizationId
    );

    if (!user) {
      return res.status(404).json({ message: 'Usuário não encontrado' });
    }

    res.json({
      id: user.id,
      name: user.name,
      email: user.email,
      role: user.role,
      permissions: user.permissions,
      createdAt: user.createdAt
    });
  } catch (error) {
    console.error('Erro ao buscar usuário:', error);
    res.status(500).json({ message: 'Erro interno do servidor' });
  }
});

