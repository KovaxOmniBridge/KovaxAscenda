});

/**
 * GET /api/tools
 * Listar todas as ferramentas
 */
app.get('/api/tools', async (req, res) => {
  try {
    const tools = await readData('tools.json');
    res.json(tools.tools);
  } catch (error) {
    console.error('Erro ao listar ferramentas:', error);
    res.status(500).json({ message: 'Erro interno do servidor' });
  }
});

/**
 * GET /api/tools/category/:categoryKey
 * Ferramentas de uma categoria específica
 */
app.get('/api/tools/category/:categoryKey', async (req, res) => {
  try {
    const tools = await readData('tools.json');
    const categoryTools = tools.tools.filter(t => t.categoryKey === req.params.categoryKey);
    res.json(categoryTools);
  } catch (error) {
    console.error('Erro ao buscar ferramentas da categoria:', error);
    res.status(500).json({ message: 'Erro interno do servidor' });
  }
});

/**
 * GET /api/tools/user/:userId
 * Ferramentas disponíveis para um usuário
 */
app.get('/api/tools/user/:userId', authenticateToken, async (req, res) => {
  try {
    const users = await readData('users.json');
    const user = users.find(u => 
      u.id === req.params.userId && 
      u.organizationId === req.user.organizationId
    );

    if (!user) {
      return res.status(404).json({ message: 'Usuário não encontrado' });
    }

    const tools = await readData('tools.json');
    const allowedCategories = user.permissions.toolCategories || [];
    
    const userTools = tools.tools.filter(t => 
      allowedCategories.includes(t.categoryKey)
    );

    res.json(userTools);
  } catch (error) {
    console.error('Erro ao buscar ferramentas do usuário:', error);
    res.status(500).json({ message: 'Erro interno do servidor' });
  }
});

