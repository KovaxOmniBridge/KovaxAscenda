/**
 * POST /api/auth/login/client
 * Login de clientes (usuários de organizações)
 */
app.post('/api/auth/login/client', async (req, res) => {
  try {
    const { email, password } = req.body;

    if (!email || !password) {
      return res.status(400).json({
        success: false,
        message: 'Email e senha são obrigatórios'
      });
    }

    // Buscar usuário no banco
    const result = await pool.query(
      `SELECT u.*, o.name as organization_name, o.slug as organization_slug
       FROM users u
       INNER JOIN organizations o ON u.organization_id = o.id
       WHERE u.email = $1 AND u.is_active = true`,
      [email.toLowerCase()]
    );

    if (result.rows.length === 0) {
      return res.status(401).json({
        success: false,
        message: 'Email ou senha incorretos'
      });
    }

    const user = result.rows[0];

    // Verificar senha
    const passwordMatch = await bcrypt.compare(password, user.password_hash);
    if (!passwordMatch) {
      return res.status(401).json({
        success: false,
        message: 'Email ou senha incorretos'
      });
    }

    // Atualizar último login
    await pool.query(
      'UPDATE users SET last_login_at = CURRENT_TIMESTAMP WHERE id = $1',
      [user.id]
    );

    // Gerar token JWT (24 horas para clientes)
    const token = jwt.sign(
      {
        userId: user.id,
        email: user.email,
        organizationId: user.organization_id,
        type: 'client'
      },
      JWT_SECRET,
      { expiresIn: '24h' }
    );

    console.log(`✓ Login bem-sucedido (CLIENT): ${email}`);

    res.json({
      success: true,
      message: 'Login realizado com sucesso',
      token,
      user: {
        id: user.id,
        name: user.name,
        email: user.email,
        organizationId: user.organization_id,
        organizationName: user.organization_name,
        organizationSlug: user.organization_slug,
        type: 'client'
      }
    });

  } catch (error) {
    console.error('Erro no login de cliente:', error);
    res.status(500).json({
      success: false,
      message: 'Erro ao processar login'
    });
  }
});

/**
 * POST /api/auth/login/developer
 * Login de desenvolvedores (acesso à plataforma)
 */
app.post('/api/auth/login/developer', async (req, res) => {
  try {
    const { email, password } = req.body;

    if (!email || !password) {
      return res.status(400).json({
        success: false,
        message: 'Email e senha são obrigatórios'
      });
    }

    // Buscar desenvolvedor no banco
    const result = await pool.query(
      'SELECT * FROM developers WHERE email = $1 AND is_active = true',
      [email.toLowerCase()]
    );

    if (result.rows.length === 0) {
      console.log(`⚠ Tentativa de login com email não encontrado: ${email}`);
      return res.status(401).json({
        success: false,
        message: 'Email ou senha incorretos'
      });
    }

    const developer = result.rows[0];

    // Verificar senha
    const passwordMatch = await bcrypt.compare(password, developer.password_hash);
    if (!passwordMatch) {
      console.log(`⚠ Tentativa de login com senha incorreta: ${email}`);
      return res.status(401).json({
        success: false,
        message: 'Email ou senha incorretos'
      });
    }

    // Atualizar último login
    await pool.query(
      'UPDATE developers SET last_login_at = CURRENT_TIMESTAMP WHERE id = $1',
      [developer.id]
    );

    // Gerar token JWT (2 horas para desenvolvedores - mais seguro)
    const token = jwt.sign(
      {
        developerId: developer.id,
        email: developer.email,
        role: developer.role,
        type: 'developer'
      },
      JWT_SECRET,
      { expiresIn: '2h' }
    );

    console.log(`🔐 Login DEVELOPER bem-sucedido: ${email} | Role: ${developer.role}`);

    res.json({
      success: true,
      message: 'Login de desenvolvedor realizado com sucesso',
      token,
      user: {
        id: developer.id,
        name: developer.name,
        email: developer.email,
        role: developer.role,
        permissions: developer.permissions,
        type: 'developer'
      }
    });

  } catch (error) {
    console.error('Erro no login de desenvolvedor:', error);
    res.status(500).json({
      success: false,
      message: 'Erro ao processar login'
    });
  }
});

