# Configuração do Banco de Dados PostgreSQL

# Conexão com o banco de dados
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ascenda_db
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Secret
JWT_SECRET=seu-secret-super-seguro-aqui-change-in-production
JWT_EXPIRES_IN=7d

# Server
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:3000
